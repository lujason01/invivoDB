# Environment Configuration Template for InvivoDB
# Copy this file to .env and replace the placeholder values with real ones

# Flask Configuration
SECRET_KEY=your-super-secret-key-here-generate-a-strong-one
FLASK_ENV=production
FLASK_APP=src/web/app.py

# Database Configuration
DATABASE_URL=sqlite:///instance/invivodb.db

# Optional: PubMed API Configuration
PUBMED_EMAIL=your-email@example.com

# Production Settings
DEBUG=False
